{
  "name": "@bank-el-hazz/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:fastify --external:socket.io --external:nanoid",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@bank-el-hazz/engine": "*",
    "fastify": "^4.28.1",
    "nanoid": "^5.0.7",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
