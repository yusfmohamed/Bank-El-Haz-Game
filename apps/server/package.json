{
  "name": "@bank-el-hazz/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:fastify --external:socket.io --external:nanoid --external:@fastify/static --external:redis --external:zod",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@bank-el-hazz/engine": "*",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "nanoid": "^5.0.7",
    "redis": "^5.8.2",
    "socket.io": "^4.7.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
